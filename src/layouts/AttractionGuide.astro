---
import '../styles.css';
import { getImage } from 'astro:assets';
import fortImage from '../assets/fort-view.jpg';
import { TOPIC_UI, GROUP_LABELS, CHECKED, type Topic, type AttractionDetail } from '../data/topic-types';
import { SITE_URL, CITY, STATE, COUNTRY, MAPS_SHARE_URL, sourcesByKeys } from '../data/site';
import { relatedFor, topicPath } from '../data/topics';

interface Props { topic: Topic; }
const { topic } = Astro.props;
const detail: AttractionDetail = topic.detail ?? {};

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? SITE_URL;
const canonical = `${siteUrl}${topicPath(topic.slug)}`;
const abs = (p: string) => `${siteUrl}${p}`;

const socialImage = await getImage({ src: fortImage, width: 1200, format: 'webp' });
const hero = socialImage.src;

const mapSearch = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${topic.h1}, Goa, India`)}`;
const groupLabel = GROUP_LABELS[topic.group];
const category = topic.kicker.split('·').pop()?.trim() ?? 'Heritage site';
const hoursLabel = detail.hoursLabel ?? 'Verify on site before you travel';
const ticketLabel = detail.ticketLabel ?? 'No verified price published — confirm with the venue';
const related = relatedFor(topic);
const sources = sourcesByKeys(topic.sources);

const sections = topic.sections.map((section) => ({
  heading: section.heading,
  paragraphs: section.paragraphs ?? [],
  bullets: section.bullets ?? [],
  note: section.note ?? ''
}));

const charmLabels: Record<string, string> = {
  history: 'History',
  architecture: 'Architecture',
  culture: 'Culture',
  experience: 'What you’ll experience'
};
const charms = detail.charms ?? {};
const charmKeys = Object.keys(charms).filter((k) => charms[k as keyof typeof charms]) as (keyof typeof charms)[];

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: topic.h1,
    name: topic.title,
    description: topic.description,
    url: canonical,
    inLanguage: 'en',
    about: { '@id': `${SITE_URL}/#attraction` },
    isPartOf: { '@id': `${SITE_URL}/#website` },
    publisher: { '@type': 'Organization', name: 'Sinquerim Fort Visitor Guide', url: SITE_URL }
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: TOPIC_UI.home, item: `${SITE_URL}/en/` },
      { '@type': 'ListItem', position: 2, name: groupLabel, item: `${SITE_URL}/en/#guides` },
      { '@type': 'ListItem', position: 3, name: topic.h1, item: canonical }
    ]
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'en',
    mainEntity: topic.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a }
    }))
  },
  {
    '@type': 'TouristAttraction',
    '@id': `${canonical}#place`,
    name: topic.h1,
    description: topic.description,
    url: canonical,
    inLanguage: 'en'
  }
];
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{topic.title}</title>
  <meta name="description" content={topic.description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en-IN" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <meta property="og:type" content="article" /><meta property="og:title" content={topic.title} /><meta property="og:description" content={topic.description} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content="Sinquerim Fort Visitor Guide" /><meta property="og:locale" content="en_IN" /><meta property="og:image" content={abs(hero)} /><meta property="og:image:alt" content="Sinquerim area, Goa" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={topic.title} /><meta name="twitter:description" content={topic.description} /><meta name="twitter:image" content={abs(hero)} />
  <meta name="theme-color" content="#143d4a" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
  <script is:inline>window.dataLayer = window.dataLayer || []; function gtag(){window.dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-HXM22WWPKP');</script>
  {import.meta.env.PROD && <script is:inline>if ('serviceWorker' in navigator) { window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); }); }</script>}
</head>
<body>
  <a class="skip-link" href="#top">Skip to content</a>
  <header class="relative z-20 w-full border-b border-[#172126]/15 bg-[#f8f4ec]"><div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-5 py-5 lg:px-10"><a href="/en/" class="flex items-center gap-3" aria-label="Sinquerim Fort English guide"><img src="/favicon.svg" alt="" width="38" height="38" /><span class="display text-lg font-bold tracking-tight">sinquerim<span class="text-[#a75238]">/</span>fort</span></a><nav class="flex items-center gap-3 text-xs font-semibold"><a class="rounded-full border border-[#172126]/25 px-4 py-2" href="/en/#guides">Guides</a><a class="rounded-full border border-[#172126]/25 px-4 py-2" href="/" hreflang="hi-IN" aria-label="हिन्दी गाइड">हिन्दी</a></nav></div></header>

  <main id="top" tabindex="-1">
    <nav aria-label="Breadcrumb" class="mx-auto max-w-5xl px-5 pt-8 text-xs text-[#657174] lg:px-10"><ol class="flex flex-wrap items-center gap-2"><li><a class="underline decoration-[#a75238]/40" href="/en/">{TOPIC_UI.home}</a></li><li aria-hidden="true">/</li><li><a class="underline decoration-[#a75238]/40" href="/en/#guides">{groupLabel}</a></li><li aria-hidden="true">/</li><li aria-current="page">{topic.h1}</li></ol></nav>

    {/* Hero: name + tagline + rating + hours + location link */}
    <section class="paper-grid px-5 pb-12 pt-10 lg:px-10"><div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[1.2fr_.8fr]"><div><p class="eyebrow">{topic.kicker}</p><h1 class="display mt-4 text-[clamp(2.6rem,6vw,5rem)] font-bold leading-[.95]">{topic.h1}</h1>{detail.tagline && <p class="display mt-4 text-xl italic text-[#46565a]">{detail.tagline}</p>}<div class="mt-7 space-y-3 text-sm leading-7 text-[#46565a]"><p><span class="eyebrow">Rating</span> · Traveller reviews are shared on Google Maps — <a class="text-[#a75238] underline decoration-[#a75238]/40" href={mapSearch} target="_blank" rel="noopener noreferrer">check the latest rating ↗</a></p><p><span class="eyebrow">Hours</span> · {hoursLabel}</p><p><span class="eyebrow">Tickets</span> · {ticketLabel}</p></div><div class="mt-7 flex flex-wrap gap-3"><a class="rounded-full bg-[#a75238] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#143d4a]" href={mapSearch} target="_blank" rel="noopener noreferrer">Open in Google Maps ↗</a><a class="rounded-full border border-[#172126]/20 px-5 py-3 text-sm" href={MAPS_SHARE_URL} target="_blank" rel="noopener noreferrer">{TOPIC_UI.mapsCta}</a></div></div><aside class="rounded-2xl bg-white/75 p-6 shadow-sm"><p class="eyebrow">Location</p><p class="mt-2 text-sm leading-6">{topic.h1}<br/>{CITY} area, {STATE}, {COUNTRY}</p><p class="mt-4 text-[11px] leading-5 text-[#657174]">{TOPIC_UI.independentText}</p><a class="mt-4 inline-block rounded-full bg-[#143d4a] px-5 py-3 text-sm font-bold text-white" href={mapSearch} target="_blank" rel="noopener noreferrer">Map &amp; directions ↗</a></aside></div></section>

    {/* 探索 / 引言 */}
    <section class="mx-auto max-w-5xl px-5 pb-12 lg:px-10"><p class="eyebrow">Overview</p><p class="mt-5 max-w-2xl text-lg leading-8 text-[#46565a]">{topic.lead}</p></section>

    {/* 景区特色 */}
    {detail.highlights?.length ? (
      <section class="bg-[#143d4a] px-5 py-16 text-[#f8f4ec] lg:px-10"><div class="mx-auto max-w-5xl"><p class="eyebrow quote-eyebrow">Highlights</p><h2 class="display mt-3 text-4xl">What makes it worth the stop</h2><ul class="mt-8 grid gap-5 sm:grid-cols-2">{detail.highlights.map((item) => <li class="rounded-2xl bg-[#f8f4ec]/10 p-6 text-sm leading-7 text-[#e7dbc7]"><span class="text-[#d28f69]">·</span> {item}</li>)}</ul></div></section>
    ) : null}

    {/* 关于 */}
    {detail.about && (
      <section class="mx-auto max-w-5xl px-5 py-16 lg:px-10"><div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow">About</p><h2 class="display mt-3 text-4xl">In a few lines</h2></div><div class="max-w-2xl space-y-6 text-lg leading-8 text-[#46565a]"><p>{detail.about}</p></div></div></section>
    )}

    {/* 基础信息表 */}
    <section class="mx-auto max-w-5xl px-5 pb-12 lg:px-10"><div class="overflow-hidden rounded-2xl border border-[#172126]/15 bg-white/75 shadow-sm"><table class="w-full text-sm"><tbody class="divide-y divide-[#172126]/15">{[
      ['Location', `${CITY} area, ${STATE}, ${COUNTRY}`],
      ['Category', category],
      ['Opening hours', hoursLabel],
      ['Tickets', ticketLabel],
      ['Verify before travel', 'Entrance, access, timings and any charge'],
      ['Map', 'Google Maps search ↗']
    ].map(([label, value]) => (
      <tr><th scope="row" class="w-1/3 bg-[#f8f4ec] px-5 py-4 text-left align-top text-xs font-semibold uppercase tracking-[.12em] text-[#657174]">{label}</th><td class="px-5 py-4 text-[#46565a]">{value === 'Google Maps search ↗' ? <a class="text-[#a75238] underline decoration-[#a75238]/40" href={mapSearch} target="_blank" rel="noopener noreferrer">{value}</a> : value}</td></tr>
    ))}</tbody></table></div><p class="mt-4 text-[11px] leading-5 text-[#657174]">{TOPIC_UI.checkedLabel}: {CHECKED} · {TOPIC_UI.independentText}</p></section>

    {/* 游览建议 */}
    {detail.tips?.length ? (
      <section class="paper-grid px-5 py-16 lg:px-10"><div class="mx-auto max-w-5xl"><p class="eyebrow">Visitor tips</p><h2 class="display mt-3 text-4xl">How to plan the visit</h2><ul class="mt-8 space-y-3">{detail.tips.map((item) => <li class="flex gap-3 text-base leading-8 text-[#46565a]"><span aria-hidden="true" class="text-[#a75238]">·</span><span>{item}</span></li>)}</ul></div></section>
    ) : null}

    {/* 原有 sections（保留，不删减） */}
    <div class="mx-auto max-w-5xl px-5 lg:px-10">
      {sections.map((section) => (
        <section class="border-t border-[#172126]/15 py-10">
          <h2 class="display text-3xl leading-tight">{section.heading}</h2>
          {section.paragraphs.map((text) => <p class="mt-5 text-base leading-8 text-[#46565a]">{text}</p>)}
          <ul class="mt-5 space-y-3">
            {section.bullets.map((item) => <li class="flex gap-3 text-sm leading-7 text-[#46565a]"><span aria-hidden="true" class="text-[#a75238]">·</span><span>{item}</span></li>)}
          </ul>
          {section.note && <p class="mt-6 rounded-xl bg-[#e7dbc7]/70 p-4 text-xs leading-6 text-[#526064]">{section.note}</p>}
        </section>
      ))}
    </div>

    {/* 发现魅力 */}
    {charmKeys.length ? (
      <section class="bg-[#e7dbc7]/40 px-5 py-16 lg:px-10"><div class="mx-auto max-w-5xl"><p class="eyebrow">Discover its appeal</p><h2 class="display mt-3 text-4xl">History, architecture, culture</h2><div class="mt-10 grid gap-8 md:grid-cols-2">{charmKeys.map((key) => <div><h3 class="display text-2xl text-[#a75238]">{charmLabels[key]}</h3><p class="mt-3 text-base leading-8 text-[#46565a]">{charms[key]}</p></div>)}</div></div></section>
    ) : null}

    {/* 游览路线（编号步骤） */}
    {detail.routeSteps?.length ? (
      <section class="mx-auto max-w-5xl px-5 py-16 lg:px-10"><p class="eyebrow">Suggested route</p><h2 class="display mt-3 text-4xl">A simple way to see it</h2><ol class="mt-8 space-y-5">{detail.routeSteps.map((step, i) => <li class="flex gap-4 rounded-2xl border border-[#172126]/15 bg-white/70 p-6 text-base leading-8 text-[#46565a]"><span class="display shrink-0 text-2xl font-bold text-[#a75238]">{i + 1}</span><span>{step}</span></li>)}</ol></section>
    ) : null}

    {/* 拍照机位 */}
    {detail.photoSpots?.length ? (
      <section class="paper-grid px-5 py-16 lg:px-10"><div class="mx-auto max-w-5xl"><p class="eyebrow">Photo spots</p><h2 class="display mt-3 text-4xl">Where to point the camera</h2><ul class="mt-8 space-y-3">{detail.photoSpots.map((item) => <li class="flex gap-3 text-base leading-8 text-[#46565a]"><span aria-hidden="true" class="text-[#a75238]">·</span><span>{item}</span></li>)}</ul></div></section>
    ) : null}

    {/* 住宿建议 */}
    {detail.stayTips && (
      <section class="bg-[#143d4a] px-5 py-16 text-[#f8f4ec] lg:px-10"><div class="mx-auto max-w-5xl"><p class="eyebrow quote-eyebrow">Where to stay</p><h2 class="display mt-3 text-4xl">Basing yourself nearby</h2><p class="mt-6 max-w-2xl text-lg leading-8 text-[#e7dbc7]">{detail.stayTips}</p><p class="mt-6"><a class="rounded-full bg-[#a75238] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#f8f4ec] hover:text-[#143d4a]" href={topicPath('stay/hotels-near-sinquerim-fort')}>Compare base areas ↗</a></p></div></section>
    )}

    {/* 游客评价 */}
    <section class="mx-auto max-w-5xl px-5 py-16 lg:px-10"><div class="rounded-2xl border border-[#172126]/15 bg-white/80 p-8 shadow-sm"><p class="eyebrow">Visitor reviews</p><h2 class="display mt-3 text-3xl">What travellers say</h2><p class="mt-5 max-w-2xl text-base leading-7 text-[#46565a]">Travellers share their own ratings and experiences on Google Maps. This independent guide does not publish or reproduce individual reviews, and it does not confirm current scores. Open the map listing to read them and to see the latest snapshot.</p><a class="mt-6 inline-block rounded-full bg-[#143d4a] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#a75238]" href={mapSearch} target="_blank" rel="noopener noreferrer">Read reviews on Google Maps ↗</a></div></section>

    {/* 交通指南（地址 + 地图链接） */}
    <section class="bg-[#e7dbc7] px-5 py-16 lg:px-10"><div class="mx-auto max-w-5xl"><p class="eyebrow">Getting here</p><h2 class="display mt-3 text-4xl">Address &amp; map</h2>{detail.transport && <p class="mt-5 max-w-2xl text-base leading-8 text-[#46565a]">{detail.transport}</p>}<p class="mt-4 text-sm text-[#526064]">{topic.h1} · {CITY} area, {STATE}, {COUNTRY}</p><a class="mt-6 inline-block rounded-full bg-[#143d4a] px-6 py-3 text-sm font-bold text-white" href={mapSearch} target="_blank" rel="noopener noreferrer">Map &amp; directions ↗</a>{detail.transportBullets?.length ? <ul class="mt-6 space-y-3">{detail.transportBullets.map((item) => <li class="flex gap-3 text-sm leading-7 text-[#46565a]"><span aria-hidden="true" class="text-[#a75238]">·</span><span>{item}</span></li>)}</ul> : null}</div></section>

    {/* 游览须知 */}
    <section class="border-t border-[#172126]/15 bg-white/60 px-5 py-16 lg:px-10"><div class="mx-auto max-w-5xl"><p class="eyebrow">Good to know</p><h2 class="display mt-3 text-4xl">Before you set off</h2>{detail.goodToKnow?.length ? <ul class="mt-8 space-y-3">{detail.goodToKnow.map((item) => <li class="flex gap-3 text-base leading-8 text-[#46565a]"><span aria-hidden="true" class="text-[#a75238]">·</span><span>{item}</span></li>)}</ul> : null}<div class="mt-8 rounded-2xl bg-[#e7dbc7]/70 p-6"><p class="font-bold">{TOPIC_UI.verifyTitle}</p><p class="mt-2 text-sm leading-7 text-[#526064]">{TOPIC_UI.verifyNote}</p></div></div></section>

    <section id="faq" class="mx-auto max-w-5xl px-5 py-16 lg:px-10"><p class="eyebrow">FAQ</p><h2 class="display mt-3 text-4xl">{TOPIC_UI.faqTitle}</h2><div class="mt-8 divide-y divide-[#172126]/15">{topic.faqs.map((faq) => <details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-bold">{faq.q}<span class="text-2xl font-normal text-[#a75238] transition group-open:rotate-45">+</span></summary><p class="mt-4 max-w-2xl text-sm leading-7 text-[#657174]">{faq.a}</p></details>)}</div></section>

    <section class="mx-auto max-w-5xl px-5 py-16 lg:px-10"><p class="eyebrow">Related</p><h2 class="display mt-3 text-4xl">{TOPIC_UI.relatedTitle}</h2><div class="mt-8 grid gap-3 sm:grid-cols-2">{related.map((item) => <a class="rounded-2xl border border-[#172126]/15 bg-white/70 p-5 text-sm font-semibold leading-6 hover:border-[#a75238]" href={topicPath(item.slug)}>{item.h1} ↗</a>)}</div><p class="mt-8"><a class="text-sm text-[#a75238] underline decoration-[#a75238]/40" href="/en/#guides">{TOPIC_UI.allGuidesCta}</a></p></section>

    <section id="sources" class="border-t border-[#172126]/15 bg-white/60 px-5 py-16 lg:px-10"><div class="mx-auto max-w-5xl"><p class="eyebrow">{TOPIC_UI.sourcesTitle}</p><h2 class="display mt-3 text-4xl">{TOPIC_UI.verifyTitle}</h2><p class="mt-5 max-w-2xl text-sm leading-7 text-[#526064]">{TOPIC_UI.verifyNote}</p><ul class="mt-8 divide-y divide-[#172126]/15">{sources.map((source) => <li class="py-4"><a class="font-bold underline decoration-[#a75238]/40" href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a><p class="mt-2 text-xs leading-6 text-[#657174]">{source.use}</p></li>)}</ul><div class="mt-8 rounded-2xl bg-[#e7dbc7]/70 p-6"><p class="font-bold">{TOPIC_UI.independentTitle}</p><p class="mt-2 text-sm leading-7 text-[#526064]">{TOPIC_UI.independentText}</p></div></div></section>
  </main>

  <footer class="bg-[#172126] px-5 py-10 text-[#dbe1da] lg:px-10"><div class="mx-auto flex max-w-5xl flex-col gap-4 text-xs"><p><a class="text-[#d28f69]" href="/en/">{TOPIC_UI.backCta}</a></p><p><a class="text-[#d28f69]" href="/en/#guides">Browse all guides ↗</a> · <a class="text-[#d28f69]" href={mapSearch} target="_blank" rel="noopener noreferrer">Google Maps ↗</a> · <a class="text-[#d28f69]" href="/en/#privacy">Privacy</a></p><p class="text-[#9aa9a7]">{TOPIC_UI.independentText}</p><p class="mono text-[#d28f69]">GOA / INDIA · {CHECKED}</p></div></footer>
</body>
</html>
