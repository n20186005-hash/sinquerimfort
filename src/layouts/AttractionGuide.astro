---
import { formatDate } from '../lib/format';
import { FULL, CITY, STATE, SITE_URL, ratings, address, geo, maps, MAPS_SHARE_URL, sourcesByKeys } from '../data/site';
import {
  TOPIC_UI,
  TOPIC_UI_HI,
  GROUP_LABELS,
  GROUP_LABELS_HI,
  GROUP_INTROS,
  GROUP_INTROS_HI,
  CHECKED,
  CHECKED_HI,
  CHARM_LABELS_HI,
  type Topic
} from '../data/topic-types';
import type { Locale } from '../i18n/types';

interface Props {
  topic: Topic;
  schema?: Topic['schema'];
  locale?: Locale;
}

const { topic, schema = 'article', locale = 'en' } = Astro.props;
const isHi = locale === 'hi';

const UI = isHi ? TOPIC_UI_HI : TOPIC_UI;
const charmLabels = {
  history: 'History',
  architecture: 'Architecture',
  culture: 'Culture',
  experience: 'What you’ll experience'
};
const CHARM_LABELS = isHi ? CHARM_LABELS_HI : charmLabels;
const GROUP_LABELS_L = isHi ? GROUP_LABELS_HI : GROUP_LABELS;
const GROUP_INTROS_L = isHi ? GROUP_INTROS_HI : GROUP_INTROS;
const CHECKED_L = isHi ? CHECKED_HI : CHECKED;
const SITE_NAME = isHi ? 'सिंकेरिम किला पर्यटक गाइड' : 'Sinquerim Fort Visitor Guide';
const ATTRACTION_NAME = isHi ? 'सिंकेरिम किला' : FULL;

const f = formatDate;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://sinquerimfort.com';
const homePath = isHi ? '/' : '/en/';
const otherLocale: Locale = isHi ? 'en' : 'hi';
const otherHref = `${siteUrl}${isHi ? `/en/${topic.slug}/` : `/${topic.slug}/`}`;
const canonical = `${siteUrl}${isHi ? `/${topic.slug}/` : `/en/${topic.slug}/`}`;

const posterUrl = maps.poster;
const related = (await import('../data/topics')).relatedFor(topic, locale);

const sources = sourcesByKeys(topic.sources);
const datePublished = '2025-06-01';
const dateModified = '2026-11-05';

const detail = topic.detail;
const category = topic.kicker.split('·').pop()?.trim() || 'Fort';
---
<!doctype html>
<html lang={isHi ? 'hi' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{topic.title}</title>
    <meta name="description" content={topic.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={isHi ? 'hi-IN' : 'en-IN'} href={canonical} />
    <link rel="alternate" hreflang={isHi ? 'en-IN' : 'hi-IN'} href={otherHref} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={isHi ? 'hi_IN' : 'en_IN'} />
    <meta property="og:title" content={topic.title} />
    <meta property="og:description" content={topic.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={posterUrl} />
    <meta property="og:image:alt" content={UI.ogAltArea} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={topic.title} />
    <meta name="twitter:description" content={topic.description} />
    <meta name="twitter:image" content={posterUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global is:inline>{globalCss}</style>
  </head>
  <body>
    <a class="skip-link" href="#top">{UI.skip}</a>
    <header class="site-header">
      <a href={homePath} class="brand">
        <span class="brand-main">sinquerim<span class="brand-slash">/</span>fort</span>
      </a>
      <nav class="site-nav">
        <a href={`${homePath}#guides`} class="nav-guides">{UI.guides}</a>
        <a href={otherHref} class="nav-switch" aria-label={UI.switchAria}>{UI.switchLabel}</a>
      </nav>
    </header>

    <main id="top" lang={isHi ? 'hi' : 'en'}>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={homePath}>{UI.home}</a>
        <span class="sep">/</span>
        <a href={`${homePath}#guides`}>{UI.breadcrumbGuides}</a>
        <span class="sep">/</span>
        <span class="current">{topic.h1}</span>
      </nav>

      <section class="hero">
        <p class="hero-kicker">{topic.kicker}</p>
        <h1 class="hero-h1">{topic.h1}</h1>
        <p class="hero-lead">{topic.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={MAPS_SHARE_URL} target="_blank" rel="noopener">{UI.mapsCta}</a>
          <a class="btn btn-secondary" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Sinquerim Fort Candolim Goa')}`} target="_blank" rel="noopener">{UI.mapDirections}</a>
        </div>
        <aside class="hero-aside">
          <p class="rating"><span class="rating-label">{UI.labelRating}</span> <span class="rating-value">{ratings.value} <span class="star">★</span></span></p>
          <p class="rating-meta">{ratings.count} · {UI.googleReviews}</p>
          <p class="rating-note"><a href={MAPS_SHARE_URL} target="_blank" rel="noopener">{UI.ratingNote}</a></p>
          <p class="hero-note">{UI.checkedLabel}: {CHECKED_L}</p>
        </aside>
      </section>

      <section class="overview">
        <p class="eyebrow">{UI.overview}</p>
        <p class="lead">{topic.description}</p>
      </section>

      {detail?.highlights && (
        <section class="highlights">
          <p class="eyebrow quote-eyebrow">{UI.highlightsEyebrow}</p>
          <h2>{UI.highlightsTitle}</h2>
          <ul class="highlight-list">
            {detail.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </section>
      )}

      <section class="about">
        <p class="eyebrow">{UI.about}</p>
        <h2>{UI.aboutTitle}</h2>
        <p class="lead">{detail?.about}</p>
      </section>

      <figure class="basic-info">
        <table>
          <tbody>
            <tr><th>{UI.tableLocation}</th><td>{CITY}, {STATE}</td></tr>
            <tr><th>{UI.tableCategory}</th><td>{category}</td></tr>
            <tr><th>{UI.tableHours}</th><td>{detail?.hoursLabel}</td></tr>
            <tr><th>{UI.tableTickets}</th><td>{detail?.ticketLabel}</td></tr>
            <tr>
              <th>{UI.tableVerify}</th>
              <td>{UI.verifyValue}</td>
            </tr>
            <tr>
              <th>{UI.tableMap}</th>
              <td><a href={MAPS_SHARE_URL} target="_blank" rel="noopener">Google Maps search ↗</a></td>
            </tr>
          </tbody>
        </table>
      </figure>

      <section class="tips">
        <p class="eyebrow">{UI.tips}</p>
        <h2>{UI.tipsTitle}</h2>
        <ul class="tips-list">
          {(detail?.tips || []).map((tip) => <li>{tip}</li>)}
        </ul>
      </section>

      <article class="prose">
        {topic.sections.map((section) => (
          <section class="guide-block">
            {section.heading && <h2>{section.heading}</h2>}
            <div class="rich" set:html={f(section.paragraphs?.map((p) => `<p>${p}</p>`).join('') || '')} />
            {section.bullets && (
              <ul class="bullets" set:html={f(section.bullets.map((b) => `<li>${b}</li>`).join(''))} />
            )}
            {section.note && <p class="note" set:html={f(`<p>${section.note}</p>`)} />}
          </section>
        ))}
      </article>

      {detail?.charms && (
        <section class="charms">
          <p class="eyebrow quote-eyebrow">{UI.charms}</p>
          <h2>{UI.charmsTitle}</h2>
          <div class="charm-grid">
            {detail.charms.history && (
              <div class="charm"><h3>{CHARM_LABELS.history}</h3><p>{detail.charms.history}</p></div>
            )}
            {detail.charms.architecture && (
              <div class="charm"><h3>{CHARM_LABELS.architecture}</h3><p>{detail.charms.architecture}</p></div>
            )}
            {detail.charms.culture && (
              <div class="charm"><h3>{CHARM_LABELS.culture}</h3><p>{detail.charms.culture}</p></div>
            )}
            {detail.charms.experience && (
              <div class="charm"><h3>{CHARM_LABELS.experience}</h3><p>{detail.charms.experience}</p></div>
            )}
          </div>
        </section>
      )}

      {detail?.routeSteps && (
        <section class="route">
          <p class="eyebrow">{UI.route}</p>
          <h2>{UI.routeTitle}</h2>
          <ol class="route-steps">
            {detail.routeSteps.map((step) => {
              const [time, ...rest] = step.split(' — ');
              return (
                <li>
                  <span class="route-time">{time}</span>
                  <span class="route-text">{rest.join(' — ')}</span>
                </li>
              );
            })}
          </ol>
        </section>
      )}

      {detail?.photoSpots && (
        <section class="photo-spots">
          <p class="eyebrow">{UI.photoSpots}</p>
          <h2>{UI.photoSpotsTitle}</h2>
          <ul class="photo-list">
            {detail.photoSpots.map((spot) => <li>{spot}</li>)}
          </ul>
        </section>
      )}

      {detail?.stayTips && (
        <section class="stay">
          <p class="eyebrow quote-eyebrow">{UI.stay}</p>
          <h2>{UI.stayTitle}</h2>
          <p class="lead">{detail.stayTips}</p>
          <p class="stay-cta">
            <a class="btn btn-secondary" href={isHi ? '/stay/hotels-near-sinquerim-fort/' : '/en/stay/hotels-near-sinquerim-fort/'}>{UI.stayCta}</a>
          </p>
        </section>
      )}

      <section class="reviews">
        <p class="eyebrow">{UI.reviews}</p>
        <h2>{UI.reviewsTitle}</h2>
        <p class="reviews-text">{UI.reviewsText}</p>
        <p class="reviews-cta">
          <a class="btn btn-secondary" href={MAPS_SHARE_URL} target="_blank" rel="noopener">{UI.reviewsCta}</a>
        </p>
      </section>

      <section class="getting-here">
        <p class="eyebrow">{UI.gettingHere}</p>
        <h2>{UI.addressMap}</h2>
        <div class="rich" set:html={f(detail ? `<p>${detail.transport}</p>` : '')} />
        {detail?.transportBullets && (
          <ul class="bullets" set:html={f(detail.transportBullets.map((b) => `<li>${b}</li>`).join(''))} />
        )}
        <p class="map-cta">
          <a class="btn btn-secondary" href={MAPS_SHARE_URL} target="_blank" rel="noopener">{UI.mapDirections}</a>
        </p>
      </section>

      {detail?.goodToKnow && (
        <section class="good-to-know">
          <p class="eyebrow">{UI.goodToKnow}</p>
          <h2>{UI.goodToKnowTitle}</h2>
          <ul class="tips-list">
            {detail.goodToKnow.map((g) => <li>{g}</li>)}
          </ul>
        </section>
      )}

      <section class="faq">
        <p class="eyebrow">{UI.faqEyebrow}</p>
        <h2>{UI.faqTitle}</h2>
        <div class="faq-list">
          {topic.faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <div class="faq-answer" set:html={f(`<p>${faq.a}</p>`)} />
            </details>
          ))}
        </div>
      </section>

      <section class="related">
        <p class="eyebrow">{UI.relatedEyebrow}</p>
        <h2>{UI.relatedTitle}</h2>
        <ul class="related-list">
          {related.map((item) => (
            <li><a href={isHi ? `/${item.slug}/` : `/en/${item.slug}/`}>{item.h1}</a></li>
          ))}
        </ul>
        <p class="related-cta"><a class="btn btn-secondary" href={`${homePath}#guides`}>{UI.allGuidesCta}</a></p>
      </section>

      <section class="sources">
        <p class="eyebrow">{UI.sourcesEyebrow}</p>
        <h2>{UI.sourcesTitle}</h2>
        <p class="sources-verify-note">{UI.verifyNote}</p>
        <ul class="sources-list">
          {sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener">{source.label}</a>
              <span class="source-use">{isHi ? source.useHi : source.use}</span>
            </li>
          ))}
        </ul>
        <div class="independent-box">
          <h3>{UI.independentTitle}</h3>
          <p>{UI.independentText}</p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p class="footer-back"><a href={homePath}>{UI.backCta}</a></p>
      <p class="footer-links">
        <a href="https://www.google.com/maps/search/?api=1&query=Sinquerim+Fort+Candolim+Goa" target="_blank" rel="noopener">Google Maps</a>
        <span class="footer-sep">·</span>
        <a href={`${homePath}privacy-policy`}>{UI.privacyLabel}</a>
        <span class="footer-sep">·</span>
        <a href={`${homePath}terms-of-service`}>{UI.termsLabel}</a>
        <span class="footer-sep">·</span>
        <a href={`${homePath}cookie-settings`}>{UI.cookiesLabel}</a>
      </p>
      <p class="footer-meta">GOA / INDIA · {CHECKED_L}</p>
    </footer>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${SITE_URL}/#website`,
          'name': SITE_NAME,
          'url': SITE_URL,
          'publisher': { '@type': 'Organization', 'name': SITE_NAME }
        },
        {
          '@type': 'WebPage',
          '@id': canonical,
          'url': canonical,
          'name': topic.title,
          'description': topic.description,
          'inLanguage': isHi ? 'hi' : 'en',
          'isPartOf': { '@id': `${SITE_URL}/#website` },
          'about': { '@id': `${SITE_URL}/#site` },
          'datePublished': datePublished,
          'dateModified': dateModified,
          'primaryImageOfPage': { '@id': `${canonical}#primaryimage` }
        },
        {
          '@type': 'ImageObject',
          '@id': `${canonical}#primaryimage`,
          'url': posterUrl,
          'name': UI.ogAltArea
        },
        {
          '@type': 'TouristAttraction',
          '@id': `${SITE_URL}/#site`,
          'name': topic.h1,
          'description': topic.description,
          'address': address,
          'geo': geo,
          'aggregateRating': {
            '@type': 'AggregateRating',
            'ratingValue': ratings.value,
            'reviewCount': ratings.count.replace(/[^\d]/g, '')
          },
          'openingHours': [['00:00', '23:59']],
          'isAccessibleForFree': true,
          'sameAs': [
            'https://en.wikipedia.org/wiki/Fort_Aguada',
            'https://www.incredibleindia.gov.in/en/destinations/goa/fort-aguada',
            'https://www.google.com/maps/place/?q=Sinquerim+Fort'
          ]
        },
        {
          '@type': 'BreadcrumbList',
          'itemListElement': [
            { '@type': 'ListItem', 'position': 1, 'name': UI.home, 'item': `${siteUrl}${homePath}` },
            { '@type': 'ListItem', 'position': 2, 'name': UI.breadcrumbGuides, 'item': `${siteUrl}${homePath}#guides` },
            { '@type': 'ListItem', 'position': 3, 'name': topic.h1, 'item': canonical }
          ]
        },
        {
          '@type': 'FAQPage',
          'inLanguage': isHi ? 'hi' : 'en',
          'mainEntity': topic.faqs.map((faq) => ({
            '@type': 'Question',
            'name': faq.q,
            'acceptedAnswer': { '@type': 'Answer', 'text': faq.a }
          }))
        },
        {
          '@type': 'Article',
          'headline': topic.h1,
          'description': topic.description,
          'inLanguage': isHi ? 'hi' : 'en',
          'name': topic.title,
          'author': { '@type': 'Organization', 'name': SITE_NAME },
          'publisher': { '@type': 'Organization', 'name': SITE_NAME },
          'datePublished': datePublished,
          'dateModified': dateModified,
          'image': { '@type': 'ImageObject', 'url': posterUrl, 'name': UI.ogAltArea },
          'about': { '@type': 'TouristAttraction', 'name': ATTRACTION_NAME, 'address': address, 'geo': geo },
          'mainEntityOfPage': { '@id': canonical }
        }
      ]
    })} />
  </body>
</html>

<style is:global>
  :root {
    --ink: #172126;
    --muted: #526064;
    --line: rgba(23, 33, 38, 0.1);
    --accent: #a75238;
    --bg: #f6f4ef;
    --card: #ffffff;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans Devanagari', sans-serif;
    color: var(--ink);
    background: var(--bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  .skip-link {
    position: absolute; left: -999px; top: 0;
    background: var(--ink); color: #fff; padding: 8px 14px; z-index: 50;
  }
  .skip-link:focus { left: 8px; top: 8px; }
  .site-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 22px; border-bottom: 1px solid var(--line);
    background: rgba(255,255,255,0.7); backdrop-filter: blur(6px);
    position: sticky; top: 0; z-index: 20;
  }
  .brand-main { font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 20px; letter-spacing: -0.01em; }
  .brand-slash { color: var(--accent); margin: 0 1px; }
  .site-nav { display: flex; gap: 18px; align-items: center; font-size: 14px; }
  .nav-guides { text-decoration: none; color: var(--muted); }
  .nav-guides:hover { color: var(--accent); }
  .nav-switch {
    text-decoration: none; border: 1px solid var(--line); border-radius: 999px;
    padding: 6px 14px; font-weight: 600; color: var(--ink);
  }
  .nav-switch:hover { border-color: var(--accent); color: var(--accent); }
  main { max-width: 760px; margin: 0 auto; padding: 30px 22px 60px; }
  .breadcrumb { font-size: 13px; color: var(--muted); margin-bottom: 26px; }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .breadcrumb .sep { margin: 0 8px; opacity: 0.5; }
  .breadcrumb .current { color: var(--ink); }
  .hero { margin-bottom: 34px; }
  .hero-kicker {
    text-transform: uppercase; letter-spacing: 0.14em; font-size: 12px;
    color: var(--accent); font-weight: 700; margin: 0 0 12px;
  }
  .hero-h1 {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600;
    font-size: 40px; line-height: 1.08; margin: 0 0 16px; letter-spacing: -0.02em;
  }
  .hero-lead { font-size: 18px; color: var(--muted); margin: 0 0 22px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; }
  .btn {
    display: inline-block; padding: 12px 18px; border-radius: 12px; font-weight: 600;
    text-decoration: none; font-size: 14px;
  }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: #8c4230; }
  .btn-secondary {
    background: #fff; color: var(--ink); border: 1px solid var(--line);
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
  .hero-aside {
    margin-top: 18px; background: var(--card); border: 1px solid var(--line);
    border-radius: 14px; padding: 16px 18px; font-size: 14px;
  }
  .hero-aside .rating-label { text-transform: uppercase; letter-spacing: 0.08em; font-size: 11px; color: var(--muted); }
  .hero-aside .rating-value { font-weight: 700; font-size: 18px; }
  .hero-aside .star { color: var(--accent); }
  .hero-aside .rating-meta { color: var(--muted); margin: 4px 0 10px; }
  .hero-aside .rating-note a { color: var(--accent); text-decoration: none; }
  .hero-aside .hero-note { margin: 10px 0 0; color: var(--muted); }
  .eyebrow {
    text-transform: uppercase; letter-spacing: 0.12em; font-size: 12px;
    color: var(--accent); font-weight: 700; margin: 0 0 8px;
  }
  .quote-eyebrow { color: var(--accent); }
  .lead { font-size: 18px; color: var(--ink); }
  .overview { margin: 0 0 34px; }
  .highlights, .about, .tips, .charms, .route, .photo-spots, .stay,
  .reviews, .getting-here, .good-to-know, .faq, .related, .sources { margin: 0 0 36px; }
  .highlights h2, .about h2, .tips h2, .charms h2, .route h2, .photo-spots h2,
  .stay h2, .reviews h2, .getting-here h2, .good-to-know h2, .faq h2, .related h2, .sources h2 {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 28px;
    margin: 0 0 16px; letter-spacing: -0.01em;
  }
  .highlight-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .highlight-list li {
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    padding: 14px 16px; font-weight: 500;
  }
  .about .lead { margin: 0; }
  .basic-info { margin: 0 0 36px; }
  .basic-info table { width: 100%; border-collapse: collapse; background: var(--card); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .basic-info th, .basic-info td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--line); font-size: 15px; vertical-align: top; }
  .basic-info th { width: 42%; color: var(--muted); font-weight: 600; }
  .basic-info tr:last-child th, .basic-info tr:last-child td { border-bottom: none; }
  .tips-list { margin: 0; padding-left: 20px; }
  .tips-list li { margin: 0 0 8px; }
  .prose { font-size: 17px; }
  .guide-block { margin: 0 0 30px; }
  .guide-block h2 {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 26px;
    margin: 0 0 14px; letter-spacing: -0.01em;
  }
  .rich p { margin: 0 0 15px; }
  .bullets { margin: 0 0 15px; padding-left: 20px; }
  .bullets li { margin: 0 0 8px; }
  .note {
    background: rgba(167, 82, 56, 0.08); border-left: 3px solid var(--accent);
    padding: 12px 16px; border-radius: 8px; font-size: 15px; color: var(--ink);
  }
  .note p { margin: 0; }
