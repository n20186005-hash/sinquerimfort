---
import '../styles.css';
import { Image, getImage } from 'astro:assets';
import fortImage from '../assets/fort-view.jpg';
import { TOPIC_UI, GROUP_LABELS, CHECKED, type Topic } from '../data/topic-types';
import {
  SITE_URL, PLUS_CODE, CITY, STATE, COUNTRY,
  MAPS_SHARE_URL, MAPS_PLUS_URL, sourcesByKeys
} from '../data/site';
import { relatedFor, topicPath } from '../data/topics';

interface Props { topic: Topic; }
const { topic } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? SITE_URL;
const canonical = `${siteUrl}${topicPath(topic.slug)}`;
const abs = (p: string) => `${siteUrl}${p}`;

const socialImage = await getImage({ src: fortImage, width: 1200, format: 'webp' });
const hero = socialImage.src;

const sections = topic.sections.map((section) => ({
  heading: section.heading,
  paragraphs: section.paragraphs ?? [],
  bullets: section.bullets ?? [],
  note: section.note ?? ''
}));
const related = relatedFor(topic);
const sources = sourcesByKeys(topic.sources);
const groupLabel = GROUP_LABELS[topic.group];

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: topic.h1,
    name: topic.title,
    description: topic.description,
    url: canonical,
    inLanguage: 'en',
    about: { '@id': `${SITE_URL}/#attraction` },
    isPartOf: { '@id': `${SITE_URL}/#website` },
    publisher: { '@type': 'Organization', name: 'Sinquerim Fort Visitor Guide', url: SITE_URL }
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: TOPIC_UI.home, item: `${SITE_URL}/en/` },
      { '@type': 'ListItem', position: 2, name: groupLabel, item: `${SITE_URL}/en/#guides` },
      { '@type': 'ListItem', position: 3, name: topic.h1, item: canonical }
    ]
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'en',
    mainEntity: topic.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a }
    }))
  }
];

if (topic.schema === 'attraction') {
  graph.push({
    '@type': 'TouristAttraction',
    '@id': `${canonical}#place`,
    name: topic.h1,
    description: topic.description,
    url: canonical,
    inLanguage: 'en'
  });
}

if (topic.schema === 'photos') {
  graph.push({
    '@type': 'ImageObject',
    '@id': `${canonical}#image`,
    contentUrl: abs(hero),
    name: 'Sinquerim Fort sea-facing laterite wall',
    caption: TOPIC_UI.photosNote,
    inLanguage: 'en'
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{topic.title}</title>
  <meta name="description" content={topic.description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en-IN" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <meta property="og:type" content="article" /><meta property="og:title" content={topic.title} /><meta property="og:description" content={topic.description} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content="Sinquerim Fort Visitor Guide" /><meta property="og:locale" content="en_IN" /><meta property="og:image" content={abs(hero)} /><meta property="og:image:alt" content="Sinquerim Fort in Candolim" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={topic.title} /><meta name="twitter:description" content={topic.description} /><meta name="twitter:image" content={abs(hero)} />
  <meta name="theme-color" content="#143d4a" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
  <script is:inline>window.dataLayer = window.dataLayer || []; function gtag(){window.dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-HXM22WWPKP');</script>
  {import.meta.env.PROD && <script is:inline>if ('serviceWorker' in navigator) { window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); }); }</script>}
</head>
<body>
  <a class="skip-link" href="#top">{TOPIC_UI.home}</a>
  <header class="relative z-20 w-full border-b border-[#172126]/15 bg-[#f8f4ec]"><div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-5 py-5 lg:px-10"><a href="/en/" class="flex items-center gap-3" aria-label="Sinquerim Fort English guide"><img src="/favicon.svg" alt="" width="38" height="38" /><span class="display text-lg font-bold tracking-tight">sinquerim<span class="text-[#a75238]">/</span>fort</span></a><nav class="flex items-center gap-3 text-xs font-semibold"><a class="rounded-full border border-[#172126]/25 px-4 py-2" href="/en/#guides">Guides</a><a class="rounded-full border border-[#172126]/25 px-4 py-2" href="/" hreflang="hi-IN" aria-label="हिन्दी गाइड">हिन्दी</a></nav></div></header>

  <main id="top" tabindex="-1">
    <nav aria-label="Breadcrumb" class="mx-auto max-w-4xl px-5 pt-8 text-xs text-[#657174] lg:px-10"><ol class="flex flex-wrap items-center gap-2"><li><a class="underline decoration-[#a75238]/40" href="/en/">{TOPIC_UI.home}</a></li><li aria-hidden="true">/</li><li><a class="underline decoration-[#a75238]/40" href="/en/#guides">{groupLabel}</a></li><li aria-hidden="true">/</li><li aria-current="page">{topic.h1}</li></ol></nav>

    <section class="paper-grid px-5 pb-14 pt-12 lg:px-10"><div class="mx-auto max-w-4xl"><p class="eyebrow">{topic.kicker}</p><h1 class="display mt-4 text-[clamp(2.6rem,6vw,5rem)] font-bold leading-[.95]">{topic.h1}</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-[#46565a]">{topic.lead}</p><div class="mt-8 flex flex-wrap gap-3"><a class="rounded-full bg-[#a75238] px-6 py-3 text-sm font-bold text-white transition hover:bg-[#143d4a]" href={MAPS_SHARE_URL} target="_blank" rel="noopener noreferrer">{TOPIC_UI.mapsCta}</a><a class="rounded-full border border-[#172126]/20 px-5 py-3 text-sm" href={MAPS_PLUS_URL} target="_blank" rel="noopener noreferrer">{TOPIC_UI.plusCta}</a></div><p class="mt-5 text-[11px] leading-5 text-[#657174]">{TOPIC_UI.checkedLabel}: {CHECKED} · {TOPIC_UI.independentText}</p></div></section>

    <section class="mx-auto max-w-4xl px-5 pb-14 lg:px-10"><div class="grid gap-4 rounded-2xl bg-white/75 p-6 shadow-sm sm:grid-cols-2"><div><p class="eyebrow">{TOPIC_UI.quickLocation}</p><p class="mt-2 text-sm leading-6">{PLUS_CODE}, {CITY}, {STATE}, {COUNTRY}</p></div><div><p class="eyebrow">{TOPIC_UI.quickCategory}</p><p class="mt-2 text-sm leading-6">Fort · Lower Aguada fortification</p></div><div><p class="eyebrow">{TOPIC_UI.quickVerify}</p><p class="mt-2 text-sm leading-6">Entrance, access, timings and any charge</p></div><div><p class="eyebrow">{TOPIC_UI.quickMaps}</p><p class="mt-2 text-sm leading-6"><a class="text-[#a75238] underline decoration-[#a75238]/40" href={MAPS_SHARE_URL} target="_blank" rel="noopener noreferrer">Google Maps listing ↗</a></p></div></div></section>

    <div class="mx-auto max-w-4xl px-5 lg:px-10">
      {sections.map((section) => (
        <section class="border-t border-[#172126]/15 py-10">
          <h2 class="display text-3xl leading-tight">{section.heading}</h2>
          {section.paragraphs.map((text) => <p class="mt-5 text-base leading-8 text-[#46565a]">{text}</p>)}
          <ul class="mt-5 space-y-3">
            {section.bullets.map((item) => <li class="flex gap-3 text-sm leading-7 text-[#46565a]"><span aria-hidden="true" class="text-[#a75238]">·</span><span>{item}</span></li>)}
          </ul>
          {section.note && <p class="mt-6 rounded-xl bg-[#e7dbc7]/70 p-4 text-xs leading-6 text-[#526064]">{section.note}</p>}
        </section>
      ))}
    </div>

    {topic.schema === 'photos' && (
      <section class="mx-auto max-w-4xl px-5 pb-14 lg:px-10"><figure class="overflow-hidden rounded-2xl bg-[#143d4a] shadow-xl"><Image src={fortImage} width={1200} widths={[480, 800, 1200]} sizes="(max-width:1023px) 100vw, 60vw" format="webp" alt="Lower Aguada / Sinquerim sea-facing fortification, historic photograph 9 August 2024" loading="lazy" class="aspect-[1.2] w-full object-cover" /><figcaption class="bg-[#f8f4ec] px-5 py-4 text-xs leading-6 text-[#657174]">{TOPIC_UI.photosNote}</figcaption></figure></section>
    )}

    <section id="faq" class="border-t border-[#172126]/15 bg-white/60 px-5 py-16 lg:px-10"><div class="mx-auto max-w-4xl"><p class="eyebrow">FAQ</p><h2 class="display mt-3 text-4xl">{TOPIC_UI.faqTitle}</h2><div class="mt-8 divide-y divide-[#172126]/15">{topic.faqs.map((faq) => <details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-bold">{faq.q}<span class="text-2xl font-normal text-[#a75238] transition group-open:rotate-45">+</span></summary><p class="mt-4 max-w-2xl text-sm leading-7 text-[#657174]">{faq.a}</p></details>)}</div></div></section>

    <section class="mx-auto max-w-4xl px-5 py-16 lg:px-10"><p class="eyebrow">Related</p><h2 class="display mt-3 text-4xl">{TOPIC_UI.relatedTitle}</h2><div class="mt-8 grid gap-3 sm:grid-cols-2">{related.map((item) => <a class="rounded-2xl border border-[#172126]/15 bg-white/70 p-5 text-sm font-semibold leading-6 hover:border-[#a75238]" href={topicPath(item.slug)}>{item.h1} ↗</a>)}</div><p class="mt-8"><a class="text-sm text-[#a75238] underline decoration-[#a75238]/40" href="/en/#guides">{TOPIC_UI.allGuidesCta}</a></p></section>

    <section id="sources" class="border-t border-[#172126]/15 bg-white/60 px-5 py-16 lg:px-10"><div class="mx-auto max-w-4xl"><p class="eyebrow">{TOPIC_UI.sourcesTitle}</p><h2 class="display mt-3 text-4xl">{TOPIC_UI.verifyTitle}</h2><p class="mt-5 max-w-2xl text-sm leading-7 text-[#526064]">{TOPIC_UI.verifyNote}</p><ul class="mt-8 divide-y divide-[#172126]/15">{sources.map((source) => <li class="py-4"><a class="font-bold underline decoration-[#a75238]/40" href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a><p class="mt-2 text-xs leading-6 text-[#657174]">{source.use}</p></li>)}</ul><div class="mt-8 rounded-2xl bg-[#e7dbc7]/70 p-6"><p class="font-bold">{TOPIC_UI.independentTitle}</p><p class="mt-2 text-sm leading-7 text-[#526064]">{TOPIC_UI.independentText}</p></div></div></section>
  </main>

  <footer class="bg-[#172126] px-5 py-10 text-[#dbe1da] lg:px-10"><div class="mx-auto flex max-w-4xl flex-col gap-4 text-xs"><p><a class="text-[#d28f69]" href="/en/">{TOPIC_UI.backCta}</a></p><p><a class="text-[#d28f69]" href="/en/#guides">Browse all guides ↗</a> · <a class="text-[#d28f69]" href={MAPS_SHARE_URL} target="_blank" rel="noopener noreferrer">Google Maps ↗</a></p><p><a class="text-[#d28f69]" href="/en/privacy-policy">Privacy Policy</a> · <a class="text-[#d28f69]" href="/en/terms-of-service">Terms of Service</a> · <a class="text-[#d28f69]" href="/en/cookie-settings">Cookie Settings</a></p><p class="text-[#9aa9a7]">{TOPIC_UI.independentText}</p><p class="mono text-[#d28f69]">GOA / INDIA · {CHECKED}</p></div></footer>
</body>
</html>
