---
import { formatDate } from '../lib/format';
import { FULL, CITY, STATE, SITE_URL, ratings, address, geo, maps, PLUS_LINK, MAPS_SHARE_URL, sourcesByKeys } from '../data/site';
import {
  TOPIC_UI,
  TOPIC_UI_HI,
  GROUP_LABELS,
  GROUP_LABELS_HI,
  GROUP_INTROS,
  GROUP_INTROS_HI,
  CHECKED,
  CHECKED_HI,
  type Topic
} from '../data/topic-types';
import type { Locale } from '../i18n/types';

interface Props {
  topic: Topic;
  schema?: Topic['schema'];
  locale?: Locale;
}

const { topic, schema = 'article', locale = 'en' } = Astro.props;
const isHi = locale === 'hi';

const UI = isHi ? TOPIC_UI_HI : TOPIC_UI;
const GROUP_LABELS_L = isHi ? GROUP_LABELS_HI : GROUP_LABELS;
const GROUP_INTROS_L = isHi ? GROUP_INTROS_HI : GROUP_INTROS;
const CHECKED_L = isHi ? CHECKED_HI : CHECKED;
const SITE_NAME = isHi ? 'सिंकेरिम किला पर्यटक गाइड' : 'Sinquerim Fort Visitor Guide';

const f = formatDate;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://sinquerimfort.com';
const homePath = isHi ? '/' : '/en/';
const otherLocale: Locale = isHi ? 'en' : 'hi';
const otherHref = `${siteUrl}${isHi ? `/en/${topic.slug}/` : `/${topic.slug}/`}`;
const canonical = `${siteUrl}${isHi ? `/${topic.slug}/` : `/en/${topic.slug}/`}`;

const posterUrl = maps.poster;
const related = (await import('../data/topics')).relatedFor(topic, locale);

const sources = sourcesByKeys(topic.sources);
const datePublished = '2025-06-01';
const dateModified = '2026-11-05';
---
<!doctype html>
<html lang={isHi ? 'hi' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{topic.title}</title>
    <meta name="description" content={topic.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={isHi ? 'hi-IN' : 'en-IN'} href={canonical} />
    <link rel="alternate" hreflang={isHi ? 'en-IN' : 'hi-IN'} href={otherHref} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={isHi ? 'hi_IN' : 'en_IN'} />
    <meta property="og:title" content={topic.title} />
    <meta property="og:description" content={topic.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={posterUrl} />
    <meta property="og:image:alt" content={UI.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={topic.title} />
    <meta name="twitter:description" content={topic.description} />
    <meta name="twitter:image" content={posterUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global is:inline>{globalCss}</style>
  </head>
  <body>
    <a class="skip-link" href="#top">{UI.home}</a>
    <header class="site-header">
      <a href={homePath} class="brand">
        <span class="brand-main">sinquerim<span class="brand-slash">/</span>fort</span>
      </a>
      <nav class="site-nav">
        <a href={`${homePath}#guides`} class="nav-guides">{UI.guides}</a>
        <a href={otherHref} class="nav-switch" aria-label={UI.switchAria}>{UI.switchLabel}</a>
      </nav>
    </header>

    <main id="top" lang={isHi ? 'hi' : 'en'}>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={homePath}>{UI.home}</a>
        <span class="sep">/</span>
        <a href={`${homePath}#guides`}>{UI.breadcrumbGuides}</a>
        <span class="sep">/</span>
        <span class="current">{topic.h1}</span>
      </nav>

      <section class="hero">
        <p class="hero-kicker">{topic.kicker}</p>
        <h1 class="hero-h1">{topic.h1}</h1>
        <p class="hero-lead">{topic.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={MAPS_SHARE_URL} target="_blank" rel="noopener">{UI.mapsCta}</a>
          <a class="btn btn-secondary" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(PLUS_LINK)}`} target="_blank" rel="noopener">{UI.plusCta}</a>
        </div>
        <p class="hero-note"><strong>{UI.checkedLabel}:</strong> {CHECKED_L} · {UI.independentText}</p>
      </section>

      <section class="quick-facts">
        <h2 class="visually-hidden">{UI.quickTitle}</h2>
        <div class="quick-grid">
          <div><dt>{UI.quickLocation}</dt><dd>{topic.h1}</dd></div>
          <div><dt>{UI.quickCategory}</dt><dd>{UI.quickCategoryValue}</dd></div>
          <div><dt>{UI.quickVerify}</dt><dd>{UI.quickMaps}</dd></div>
        </div>
      </section>

      <article class="prose">
        {topic.sections.map((section) => (
          <section class="guide-block">
            {section.heading && <h2>{section.heading}</h2>}
            <div class="rich" set:html={f(section.paragraphs?.map((p) => `<p>${p}</p>`).join('') || '')} />
            {section.bullets && (
              <ul class="bullets" set:html={f(section.bullets.map((b) => `<li>${b}</li>`).join(''))} />
            )}
            {section.note && <p class="note" set:html={f(`<p>${section.note}</p>`)} />}
          </section>
        ))}

        {schema === 'photos' && (
          <figure class="guide-photo">
            <img src={posterUrl} alt={UI.ogAlt} loading="lazy" width="1200" height="800" />
            <figcaption>{UI.photosNote}</figcaption>
          </figure>
        )}
      </article>

      <section class="faq">
        <p class="eyebrow">{UI.faqEyebrow}</p>
        <h2>{UI.faqTitle}</h2>
        <div class="faq-list">
          {topic.faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <div class="faq-answer" set:html={f(`<p>${faq.a}</p>`)} />
            </details>
          ))}
        </div>
      </section>

      <section class="related">
        <p class="eyebrow">{UI.relatedEyebrow}</p>
        <h2>{UI.relatedTitle}</h2>
        <ul class="related-list">
          {related.map((item) => (
            <li><a href={isHi ? `/${item.slug}/` : `/en/${item.slug}/`}>{item.h1}</a></li>
          ))}
        </ul>
        <p class="related-cta"><a class="btn btn-secondary" href={`${homePath}#guides`}>{UI.allGuidesCta}</a></p>
      </section>

      <section class="sources">
        <p class="eyebrow">{UI.sourcesEyebrow}</p>
        <h2>{UI.sourcesTitle}</h2>
        <p class="sources-verify-note">{UI.verifyNote}</p>
        <ul class="sources-list">
          {sources.map((source) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener">{source.label}</a>
              <span class="source-use">{isHi ? source.useHi : source.use}</span>
            </li>
          ))}
        </ul>
        <div class="independent-box">
          <h3>{UI.independentTitle}</h3>
          <p>{UI.independentText}</p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p class="footer-back"><a href={homePath}>{UI.backCta}</a></p>
      <p class="footer-links">
        <a href="https://www.google.com/maps/search/?api=1&query=Sinquerim+Fort+Candolim+Goa" target="_blank" rel="noopener">Google Maps</a>
        <span class="footer-sep">·</span>
        <a href={`${homePath}privacy-policy`}>{UI.privacyLabel}</a>
        <span class="footer-sep">·</span>
        <a href={`${homePath}terms-of-service`}>{UI.termsLabel}</a>
        <span class="footer-sep">·</span>
        <a href={`${homePath}cookie-settings`}>{UI.cookiesLabel}</a>
      </p>
      <p class="footer-meta">GOA / INDIA · {CHECKED_L}</p>
    </footer>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${SITE_URL}/#website`,
          'name': SITE_NAME,
          'url': SITE_URL,
          'publisher': { '@type': 'Organization', 'name': SITE_NAME }
        },
        {
          '@type': 'WebPage',
          '@id': canonical,
          'url': canonical,
          'name': topic.title,
          'description': topic.description,
          'inLanguage': isHi ? 'hi' : 'en',
          'isPartOf': { '@id': `${SITE_URL}/#website` },
          'about': { '@id': `${SITE_URL}/#site` },
          'datePublished': datePublished,
          'dateModified': dateModified,
          'primaryImageOfPage': { '@id': `${canonical}#primaryimage` }
        },
        {
          '@type': 'ImageObject',
          '@id': `${canonical}#primaryimage`,
          'url': posterUrl,
          'name': UI.photoName
        },
        {
          '@type': 'BreadcrumbList',
          'itemListElement': [
            { '@type': 'ListItem', 'position': 1, 'name': UI.home, 'item': `${siteUrl}${homePath}` },
            { '@type': 'ListItem', 'position': 2, 'name': UI.breadcrumbGuides, 'item': `${siteUrl}${homePath}#guides` },
            { '@type': 'ListItem', 'position': 3, 'name': topic.h1, 'item': canonical }
          ]
        },
        {
          '@type': 'FAQPage',
          'inLanguage': isHi ? 'hi' : 'en',
          'mainEntity': topic.faqs.map((faq) => ({
            '@type': 'Question',
            'name': faq.q,
            'acceptedAnswer': { '@type': 'Answer', 'text': faq.a }
          }))
        },
        {
          '@type': 'Article',
          'headline': topic.h1,
          'description': topic.description,
          'inLanguage': isHi ? 'hi' : 'en',
          'name': topic.title,
          'author': { '@type': 'Organization', 'name': SITE_NAME },
          'publisher': { '@type': 'Organization', 'name': SITE_NAME },
          'datePublished': datePublished,
          'dateModified': dateModified,
          'image': { '@type': 'ImageObject', 'url': posterUrl, 'name': UI.photoName },
          'about': { '@type': 'TouristAttraction', 'name': FULL, 'address': address, 'geo': geo },
          'mainEntityOfPage': { '@id': canonical }
        }
      ]
    })} />
  </body>
</html>

<script is:inline define:vars={{ posterUrl, canonical, FULL, CITY, STATE, SITE_NAME, siteUrl }}>
  (function () {
    var d = document;
    var picture = d.querySelector('figure.guide-photo');
  })();
</script>

<style is:global>
  :root {
    --ink: #172126;
    --muted: #526064;
    --line: rgba(23, 33, 38, 0.1);
    --accent: #a75238;
    --bg: #f6f4ef;
    --card: #ffffff;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans Devanagari', sans-serif;
    color: var(--ink);
    background: var(--bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  .skip-link {
    position: absolute; left: -999px; top: 0;
    background: var(--ink); color: #fff; padding: 8px 14px; z-index: 50;
  }
  .skip-link:focus { left: 8px; top: 8px; }
  .site-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 22px; border-bottom: 1px solid var(--line);
    background: rgba(255,255,255,0.7); backdrop-filter: blur(6px);
    position: sticky; top: 0; z-index: 20;
  }
  .brand-main { font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 20px; letter-spacing: -0.01em; }
  .brand-slash { color: var(--accent); margin: 0 1px; }
  .site-nav { display: flex; gap: 18px; align-items: center; font-size: 14px; }
  .nav-guides { text-decoration: none; color: var(--muted); }
  .nav-guides:hover { color: var(--accent); }
  .nav-switch {
    text-decoration: none; border: 1px solid var(--line); border-radius: 999px;
    padding: 6px 14px; font-weight: 600; color: var(--ink);
  }
  .nav-switch:hover { border-color: var(--accent); color: var(--accent); }
  main { max-width: 760px; margin: 0 auto; padding: 30px 22px 60px; }
  .breadcrumb { font-size: 13px; color: var(--muted); margin-bottom: 26px; }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  .breadcrumb .sep { margin: 0 8px; opacity: 0.5; }
  .breadcrumb .current { color: var(--ink); }
  .hero { margin-bottom: 34px; }
  .hero-kicker {
    text-transform: uppercase; letter-spacing: 0.14em; font-size: 12px;
    color: var(--accent); font-weight: 700; margin: 0 0 12px;
  }
  .hero-h1 {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600;
    font-size: 40px; line-height: 1.08; margin: 0 0 16px; letter-spacing: -0.02em;
  }
  .hero-lead { font-size: 18px; color: var(--muted); margin: 0 0 22px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; }
  .btn {
    display: inline-block; padding: 12px 18px; border-radius: 12px; font-weight: 600;
    text-decoration: none; font-size: 14px;
  }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: #8c4230; }
  .btn-secondary {
    background: #fff; color: var(--ink); border: 1px solid var(--line);
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }
  .hero-note { font-size: 13px; color: var(--muted); margin: 0; }
  .quick-facts {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px;
    padding: 18px 20px; margin: 0 0 36px;
  }
  .quick-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 0; }
  .quick-grid dt { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 4px; }
  .quick-grid dd { margin: 0; font-weight: 600; font-size: 15px; }
  .prose { font-size: 17px; }
  .guide-block { margin: 0 0 30px; }
  .guide-block h2 {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 26px;
    margin: 0 0 14px; letter-spacing: -0.01em;
  }
  .rich p { margin: 0 0 15px; }
  .bullets { margin: 0 0 15px; padding-left: 20px; }
  .bullets li { margin: 0 0 8px; }
  .note {
    background: rgba(167, 82, 56, 0.08); border-left: 3px solid var(--accent);
    padding: 12px 16px; border-radius: 8px; font-size: 15px; color: var(--ink);
  }
  .note p { margin: 0; }
  .guide-photo { margin: 0 0 30px; }
  .guide-photo img { width: 100%; border-radius: 14px; display: block; }
  .guide-photo figcaption { font-size: 13px; color: var(--muted); margin-top: 10px; }
  .faq, .related, .sources { margin: 0 0 36px; }
  .eyebrow {
    text-transform: uppercase; letter-spacing: 0.12em; font-size: 12px;
    color: var(--accent); font-weight: 700; margin: 0 0 8px;
  }
  .faq h2, .related h2, .sources h2 {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 28px;
    margin: 0 0 18px; letter-spacing: -0.01em;
  }
  .faq-list { display: grid; gap: 10px; }
  .faq-item {
    background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    padding: 14px 16px;
  }
  .faq-item summary { font-weight: 600; cursor: pointer; }
  .faq-answer { margin-top: 10px; color: var(--muted); font-size: 15px; }
  .faq-answer p { margin: 0; }
  .related-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .related-list a {
    color: var(--accent); text-decoration: none; font-weight: 500;
    border-bottom: 1px solid rgba(167,82,56,0.3);
  }
  .related-list a:hover { border-bottom-color: var(--accent); }
  .related-cta { margin-top: 16px; }
  .sources-verify-note { font-size: 14px; color: var(--muted); margin: 0 0 16px; }
  .sources-list { list-style: none; padding: 0; margin: 0 0 20px; display: grid; gap: 12px; }
  .sources-list a { font-weight: 600; text-decoration: none; color: var(--ink); }
  .sources-list a:hover { color: var(--accent); }
  .source-use { display: block; font-size: 13px; color: var(--muted); margin-top: 2px; }
  .independent-box {
    background: var(--card); border: 1px solid var(--line); border-radius: 14px;
    padding: 16px 18px;
  }
  .independent-box h3 { margin: 0 0 8px; font-size: 16px; }
  .independent-box p { margin: 0; font-size: 14px; color: var(--muted); }
  .site-footer { max-width: 760px; margin: 0 auto; padding: 30px 22px 50px; border-top: 1px solid var(--line); }
  .footer-back { margin: 0 0 14px; }
  .footer-back a { color: var(--accent); text-decoration: none; font-weight: 600; }
  .footer-links { font-size: 13px; color: var(--muted); margin: 0 0 8px; }
  .footer-links a { color: var(--muted); text-decoration: none; }
  .footer-links a:hover { color: var(--accent); }
  .footer-sep { margin: 0 8px; opacity: 0.5; }
  .footer-meta { font-size: 12px; color: var(--muted); margin: 0; letter-spacing: 0.04em; }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
  @media (max-width: 640px) {
    .hero-h1 { font-size: 30px; }
    .quick-grid { grid-template-columns: 1fr; gap: 12px; }
    .prose { font-size: 16px; }
  }
</style>
